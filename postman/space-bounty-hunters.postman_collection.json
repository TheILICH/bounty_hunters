{
  "info": {
    "name": "Space Bounty Hunters",
    "description": "Run top to bottom. Create hunt log saves the new id into {{huntId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "huntId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Criminals",
      "item": [
        {
          "name": "List all criminals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/criminals/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "criminals",
                ""
              ]
            }
          }
        },
        {
          "name": "Filter + sort (min_reward, armed, -reward)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            }
          }
        },
        {
          "name": "Filter reward range + sort asc",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/criminals/?min_reward=2000&max_reward=13000&sort=reward",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "2000"
                },
                {
                  "key": "max_reward",
                  "value": "13000"
                },
                {
                  "key": "sort",
                  "value": "reward"
                }
              ]
            }
          }
        },
        {
          "name": "Filter flags (has_crew, escape_master)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/criminals/?has_crew=true&escape_master=true",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "has_crew",
                  "value": "true"
                },
                {
                  "key": "escape_master",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get criminal by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/criminals/3/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "criminals",
                "3",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Hunt logs CRUD",
      "item": [
        {
          "name": "List all hunt logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/hunts/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "hunts",
                ""
              ]
            }
          }
        },
        {
          "name": "List hunt logs of one criminal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/hunts/?criminal_id=3",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "hunts",
                ""
              ],
              "query": [
                {
                  "key": "criminal_id",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
          "name": "Create hunt log",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/hunts/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field near Titan.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// save new id for the next requests",
                  "pm.collectionVariables.set('huntId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get hunt log by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/hunts/{{huntId}}/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Update hunt log (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/hunts/{{huntId}}/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"notes\": \"Second try: caught her at dock 14.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete hunt log",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/hunts/{{huntId}}/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Get deleted hunt log (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/hunts/{{huntId}}/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            }
          }
        }
      ]
    },
